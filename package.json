{
  "name": "quranstudio-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/DashingMZA/quranstudio-web#readme",
  "keywords": [
    "Quran video maker",
    "Islamic video editor",
    "Quran video studio",
    "Quran videos",
    "Quran video creator"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "deploy:cf": "pnpm build && npx wrangler deploy",
    "test": "pnpm test:types && pnpm test:build && pnpm test:links",
    "test:types": "tsc --noEmit -p tsconfig.json",
    "test:build": "astro build",
    "test:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  }
}
