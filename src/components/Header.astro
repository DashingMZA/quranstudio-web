---
import { SITE_NAME, NAV_LINKS, APP_URL } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-surface-950/80 backdrop-blur-xl">
  <div class="container-narrow flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 font-bold text-lg tracking-tight">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-sm font-extrabold text-white">QS</span>
      <span>{SITE_NAME}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="btn-ghost text-sm"
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={APP_URL} class="btn-secondary hidden sm:inline-flex text-sm py-2 px-4">
        Open Web App
      </a>
      <a href="/download" class="btn-primary text-sm py-2 px-4">
        Download
      </a>
    </div>
  </div>
</header>
