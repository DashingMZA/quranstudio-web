---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout seo={{ title: "Page not found — Quran Studio", description: "The page you requested does not exist." }}>
  <Header />
  <main class="section flex-1">
    <div class="container-narrow text-center max-w-xl">
      <p class="text-brand-400 font-semibold text-sm tracking-wide uppercase mb-3">404</p>
      <h1 class="text-4xl font-extrabold tracking-tight mb-4">Page not found</h1>
      <p class="text-white/60 mb-8">That URL does not exist. Head back home or open the app.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary">Go home</a>
        <a href="/download" class="btn-secondary">Download</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
