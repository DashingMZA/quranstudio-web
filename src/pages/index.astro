---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  SITE_NAME,
  APP_URL,
  GITHUB_REPO,
  LATEST_RELEASE,
  DEFAULT_SEO,
} from "../config/site";

const features = [
  {
    title: "Surah & Verse Navigation",
    desc: "Browse any Surah and pick exact verse ranges with a clean, fast picker.",
    icon: "📖",
  },
  {
    title: "Multiple Reciters",
    desc: "Choose from renowned Quran reciters with high-quality timed audio.",
    icon: "🎙️",
  },
  {
    title: "Typography Controls",
    desc: "Arabic and translation fonts, colors, highlighting — style every line.",
    icon: "✨",
  },
  {
    title: "Backgrounds",
    desc: "Solid colors, custom images, or Pixabay stock — make every video unique.",
    icon: "🖼️",
  },
  {
    title: "Aspect Ratios",
    desc: "9:16 for Reels/TikTok, 1:1 for Instagram, 16:9 for YouTube — one click.",
    icon: "📱",
  },
  {
    title: "Private MP4 Export",
    desc: "Client-side HD export with WebCodecs. Your videos never leave your device.",
    icon: "🔒",
  },
];

const steps = [
  {
    n: "01",
    title: "Pick verses & reciter",
    desc: "Select a Surah range and a reciter. Audio is timed and ready.",
  },
  {
    n: "02",
    title: "Style the canvas",
    desc: "Fonts, colors, backgrounds, headers, translation — live preview.",
  },
  {
    n: "03",
    title: "Export HD MP4",
    desc: "One click. Client-side render. Share on YouTube, Reels, or anywhere.",
  },
];
---

<Layout>
  <Header />

  <main id="bms-main">
    <!-- Hero — left copy + right visual, cream bg like Niche Miner -->
    <section class="relative overflow-hidden pt-16 sm:pt-24 pb-16 sm:pb-28">
      <div class="container-narrow">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <div class="badge mb-5">
              <span aria-hidden="true">🎬</span>
              Free · Open source · Web + Desktop
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight leading-[1.08] text-ink max-w-xl">
              Create beautiful<br class="hidden sm:block" />
              Quran recitation videos
            </h1>
            <p class="mt-6 text-lg text-ink-muted max-w-lg leading-relaxed">
              {DEFAULT_SEO.description}
              Export in HD for YouTube, Reels, and more — all on your device.
            </p>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-soft">
              <li class="flex items-center gap-1.5"><span class="text-brand-600 font-bold">✓</span> Free forever</li>
              <li class="flex items-center gap-1.5"><span class="text-brand-600 font-bold">✓</span> No account required</li>
              <li class="flex items-center gap-1.5"><span class="text-brand-600 font-bold">✓</span> Windows · Mac · Linux</li>
            </ul>
            <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
              <a href="/download" class="btn-primary text-base px-6 py-3.5 no-underline">
                Download for Desktop
              </a>
              <a href={APP_URL} target="_blank" rel="noopener" class="btn-secondary text-base px-6 py-3.5 no-underline">
                Open Web App →
              </a>
            </div>
            <p class="mt-4 text-sm text-ink-faint">
              Latest:{" "}
              <a href={LATEST_RELEASE.url} class="link-accent" target="_blank" rel="noopener">
                {LATEST_RELEASE.name}
              </a>
            </p>
          </div>

          <div class="relative hidden sm:block">
            <div class="relative rounded-2xl border border-cream-300 bg-white shadow-xl shadow-ink/5 p-5 overflow-hidden">
              <div class="flex items-center gap-1.5 mb-4">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
                <span class="ml-3 text-xs font-medium text-ink-faint">Quran Studio · Editor</span>
              </div>
              <div class="rounded-xl bg-gradient-to-br from-ink via-surface-800 to-brand-900 aspect-[16/10] flex items-center justify-center p-8 relative overflow-hidden">
                <div class="absolute inset-0 opacity-30 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-500/40 to-transparent"></div>
                <div class="relative text-center space-y-3">
                  <p class="text-2xl sm:text-3xl font-bold text-white/95 leading-relaxed" dir="rtl" lang="ar" style="font-family: 'Amiri', 'Traditional Arabic', serif;">
                    بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ
                  </p>
                  <p class="text-sm text-white/60">Surah Al-Fatihah · 1:1</p>
                </div>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full bg-brand-50 text-brand-700 text-xs font-semibold px-2.5 py-1 border border-brand-100">9:16 Reels</span>
                <span class="rounded-full bg-cream-100 text-ink-muted text-xs font-semibold px-2.5 py-1 border border-cream-300">1:1 Instagram</span>
                <span class="rounded-full bg-cream-100 text-ink-muted text-xs font-semibold px-2.5 py-1 border border-cream-300">16:9 YouTube</span>
              </div>
            </div>
            <div class="absolute -bottom-3 -left-3 sm:-left-6 rounded-xl border border-cream-300 bg-white px-3 py-2 shadow-md text-xs font-medium text-ink-muted flex items-center gap-2">
              <span class="text-brand-600">✓</span> Client-side HD export
            </div>
            <div class="absolute -top-3 -right-2 sm:-right-4 rounded-xl border border-cream-300 bg-white px-3 py-2 shadow-md text-xs font-medium text-ink-muted flex items-center gap-2">
              <span class="text-brand-600">🔒</span> Private · no upload
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-cream-300 bg-white">
      <div class="container-narrow py-10 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-2xl font-extrabold text-brand-600">Free</div>
          <div class="text-sm text-ink-soft mt-1">Forever open source</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-brand-600">HD</div>
          <div class="text-sm text-ink-soft mt-1">Client-side MP4</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-brand-600">3</div>
          <div class="text-sm text-ink-soft mt-1">Aspect ratios</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-brand-600">Private</div>
          <div class="text-sm text-ink-soft mt-1">No server upload</div>
        </div>
      </div>
    </section>

    <section id="features" class="section">
      <div class="container-narrow">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            Everything you need to make shareable Quran videos
          </h2>
          <p class="mt-4 text-ink-muted leading-relaxed">
            From verse selection to final MP4 — one focused editor built for creators.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {features.map((f) => (
            <div class="card hover:border-brand-200 hover:shadow-md transition">
              <div class="text-2xl mb-3">{f.icon}</div>
              <h3 class="font-bold text-lg text-ink mb-2">{f.title}</h3>
              <p class="text-sm text-ink-muted leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section bg-white border-y border-cream-300">
      <div class="container-narrow">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <p class="text-sm font-bold uppercase tracking-wider text-brand-600 mb-3">How it works</p>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            From verses to video in three steps
          </h2>
          <p class="mt-4 text-ink-muted">No account. No upload. Just create and export.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {steps.map((s) => (
            <div class="relative">
              <div class="text-brand-200 text-5xl font-extrabold mb-2 leading-none">{s.n}</div>
              <h3 class="text-xl font-bold text-ink mb-2">{s.title}</h3>
              <p class="text-ink-muted text-sm leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-narrow">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink">
            Web or desktop — same editor
          </h2>
          <p class="mt-4 text-ink-muted">
            Use it in the browser or install the native app for Windows, macOS, and Linux.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
          <a href={APP_URL} target="_blank" rel="noopener" class="card group hover:border-brand-300 transition flex flex-col no-underline">
            <div class="text-3xl mb-3">🌐</div>
            <h3 class="font-bold text-lg text-ink group-hover:text-brand-600 transition">Web App</h3>
            <p class="text-sm text-ink-muted mt-2 flex-1 leading-relaxed">
              Run instantly in Chrome, Edge, or Firefox with WebCodecs support. No install required.
            </p>
            <span class="mt-4 text-sm font-bold text-brand-600">Open app →</span>
          </a>
          <a href="/download" class="card group hover:border-brand-300 transition flex flex-col no-underline">
            <div class="text-3xl mb-3">💻</div>
            <h3 class="font-bold text-lg text-ink group-hover:text-brand-600 transition">Desktop App</h3>
            <p class="text-sm text-ink-muted mt-2 flex-1 leading-relaxed">
              Native installers for Windows, macOS (Intel + Apple Silicon), and Linux (AppImage, deb, rpm).
            </p>
            <span class="mt-4 text-sm font-bold text-brand-600">Download v{LATEST_RELEASE.version} →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section border-t border-cream-300 bg-white">
      <div class="container-narrow text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink">Open source & free forever</h2>
        <p class="mt-4 text-ink-muted max-w-xl mx-auto leading-relaxed">
          Built with React, Vite, TypeScript, Tailwind, and Tauri. Star the repo, report issues, or contribute.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href={GITHUB_REPO} target="_blank" rel="noopener" class="btn-primary no-underline">
            View on GitHub
          </a>
          <a href="/download" class="btn-secondary no-underline">
            Download latest release
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
